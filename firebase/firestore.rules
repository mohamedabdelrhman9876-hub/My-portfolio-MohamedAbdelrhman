rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() && request.auth.uid == "YOUR_OWNER_UID";
    }

    function isValidMessage() {
      return request.resource.data.keys().hasOnly([
        "name", "email", "subject", "message", "read", "createdAt"
      ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.subject is string
        && request.resource.data.message is string
        && request.resource.data.read is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 200
        && request.resource.data.subject.size() >= 2
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 5000;
    }

    function isValidPost() {
      return request.resource.data.keys().hasOnly([
        "title", "excerpt", "content", "imageUrl", "ownerUid", "createdAt", "updatedAt"
      ])
        && request.resource.data.title is string
        && request.resource.data.excerpt is string
        && request.resource.data.content is string
        && (request.resource.data.imageUrl == null || request.resource.data.imageUrl is string)
        && request.resource.data.ownerUid is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.excerpt.size() >= 20
        && request.resource.data.excerpt.size() <= 250
        && request.resource.data.content.size() >= 50
        && request.resource.data.content.size() <= 12000
        && (request.resource.data.imageUrl == null || request.resource.data.imageUrl.size() >= 0)
        && request.resource.data.ownerUid == request.auth.uid;
    }

    match /users/{userId} {
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow create: if isValidMessage();
      allow read: if isAuthenticated();
      allow update, delete: if isOwner();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isOwner() && isValidPost();
      allow update: if isOwner() && resource.data.ownerUid == request.auth.uid && isValidPost();
      allow delete: if isOwner() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
